# Let the rig user restart the destoner screen without a password.
#
# Install with:
#     sudo install -m 440 -o root -g root \
#         ~/caliban/rig/inline/caliban-inline.sudoers /etc/sudoers.d/caliban-inline
#
# Same reasoning as ../caliban-rig.sudoers: update.sh runs from a timer as
# ttownshend and restarts the service after a pull. Scoped to these verbs on
# this one unit.
ttownshend ALL=(root) NOPASSWD: /usr/bin/systemctl start caliban-inline-screen, /usr/bin/systemctl stop caliban-inline-screen, /usr/bin/systemctl restart caliban-inline-screen
